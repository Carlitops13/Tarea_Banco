# Variables de entorno para Railway
#    Agrega las 3 variables de arriba
#    Run > Edit Configurations > Environment variables
# 3. Si usas IDE (IntelliJ, Eclipse):

#    java -jar target/tarea-banco.jar
#    export PGPASSWORD="tu_contraseña"
#    export PGUSER="tu_usuario"
#    export DATABASE_URL="tu_url"
# 2. En Linux/Mac:

#    java -jar target/tarea-banco.jar
#    $env:PGPASSWORD = "tu_contraseña"
#    $env:PGUSER = "tu_usuario"
#    $env:DATABASE_URL = "tu_url"
# 1. En Windows (PowerShell):
# NOTA: Para usar estas variables en tu aplicación Java:

PGPASSWORD=TuContraseñaAqui
PGUSER=postgres
PGDATABASE=railway
PGPORT=5432
PGHOST=containers-us-west-xxx.railway.app
# O usa las variables individuales:

DATABASE_URL=postgresql://postgres:TuContraseñaAqui@containers-us-west-xxx.railway.app:5432/railway
# Formato: postgresql://usuario:contraseña@host:puerto/base_datos
# DATABASE_URL es la cadena de conexión completa de Railway

# (NO incluyas esto en repositorios públicos por seguridad)
# Copia estos valores desde el panel de Railway y guárdalos en un archivo .env

